# Copy to .env and adjust.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=false

# Hostnames/IPs the app is reached by (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,nas.local
# Full origins, needed for form posts when served over https or a non-default port
CSRF_TRUSTED_ORIGINS=http://nas.local:5001

# Set to true when behind a reverse proxy that terminates HTTPS
BEHIND_PROXY=false
SECURE_COOKIES=false

TIME_ZONE=Europe/Berlin
SITE_NAME=Popcorn

# Created/updated as admin on every container start (optional)
INITIAL_ADMIN_EMAIL=

# SMTP for login codes and friend requests. Leave EMAIL_HOST empty to print emails to the container logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Popcorn <>

# Login code lifetime in seconds
LOGIN_CODE_MAX_AGE=600

# Anyone can create an account. false: only with adduser.
REGISTRATION_OPEN=true
# Address of the app for links in emails (default: the first CSRF_TRUSTED_ORIGINS entry)
SITE_URL=

# TMDB (https://www.themoviedb.org/settings/api): search, posters, genres, where to watch. Empty: titles as typed.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
# Default country for where to watch (everyone can pick their own)
WATCH_REGION=DE

# AI for imports that TMDB alone can't read (https://platform.openai.com/api-keys). Empty: no AI.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_EFFORT=low
# What AI may cost per day in USD: per person (admins can change it per person) and for all together
AI_DAILY_LIMIT_USD=0.10
AI_GLOBAL_DAILY_LIMIT_USD=1.00
